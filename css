 margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:'Poppins',sans-serif;
  background:#f5f7f3;
  color:#222;
}

.hero{
  height:100vh;
  background:url("https://images.unsplash.com/photo-1441974231531-c6227db76b6e")
  center/cover;
  position:relative;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,60,30,.55);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  color:white;
}

.hero h1{
  font-size:4rem;
}

.hero p{
  margin:20px 0;
  font-size:1.2rem;
}

.btn{
  background:#4CAF50;
  color:white;
  text-decoration:none;
  padding:14px 30px;
  border-radius:40px;
  transition:.3s;
}

.btn:hover{
  background:#2e7d32;
}

.about{
  padding:80px 10%;
  text-align:center;
}

.about h2{
  color:#2e7d32;
  margin-bottom:20px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:25px;
  padding:50px 10%;
}

.card{
  background:white;
  padding:30px;
  border-radius:20px;
  box-shadow:0 10px 30px rgba(0,0,0,.08);
  text-align:center;
  transition:.3s;
}

.card:hover{
  transform:translateY(-10px);
}

.card span{
  font-size:3rem;
}

.card h3{
  margin:15px 0;
  color:#2e7d32;
}

.stats{
  background:linear-gradient(135deg,#2e7d32,#4CAF50);
  color:white;
  display:flex;
  justify-content:space-around;
  flex-wrap:wrap;
  padding:60px 20px;
}

.stats h2{
  font-size:3rem;
}

footer{
  text-align:center;
  padding:25px;
  background:#1b5e20;
  color:white;
}
